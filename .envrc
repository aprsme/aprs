# shellcheck shell=bash
# shellcheck disable=SC1091

# Every flake input is locked and nothing in flake.nix or nix/ reads the
# ambient environment, so this stays pure -- no `--impure`.
use flake .

# use_flake only watches flake.nix and flake.lock, so a nix/*.nix edit would
# otherwise leave direnv serving a stale environment until one of those two
# files was touched.
watch_dir nix

dotenv_if_exists .env.local
